# Copy this file to .env before starting Docker Compose.
# Use a unique value with at least 8 characters.
MARCHITECT_INITIAL_ADMIN_CODE=replace-with-a-long-unique-admin-code

# Optional: creates one initial user access code. Leave blank to issue users
# later from the administrator screen.
MARCHITECT_INITIAL_USER_CODE=

# Public web port and the Docker-published Minecraft server port range.
MARCHITECT_WEB_PORT=5173
MARCHITECT_MINECRAFT_PORT_RANGE=25565-25665

# Numeric UID/GID of the Ubuntu account that owns this project directory.
# Find them with: id -u && id -g
MARCHITECT_UID=1000
MARCHITECT_GID=1000
