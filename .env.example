# Copy to .env before starting MArchitect. / 실행 전에 .env로 복사하세요.
# First administrator code: choose a long, private code (at least 8 characters).
# 최초 관리자 코드: 본인만 아는 긴 코드(8자 이상)를 입력하세요.
# Change it later in Server settings. Keep this entry for future starts.
# 이후 웹의 서버 설정에서 변경하세요. 실행에 필요하므로 이 항목은 남겨 두세요.
MARCHITECT_INITIAL_ADMIN_CODE=replace-with-a-long-unique-admin-code

# Optional user code. Leave empty to issue codes in User management.
# 선택 사항: 웹의 사용자 관리에서 코드를 발급하려면 비워 두세요.
# If set, this code is created whenever no user codes exist.
# 값을 입력하면 사용자 코드가 하나도 없을 때 이 코드가 생성됩니다.
MARCHITECT_INITIAL_USER_CODE=

# Web console port. / 웹 콘솔 접속 포트입니다.
MARCHITECT_WEB_PORT=5173
# Game ports: assign a different port in this range to each running server.
# 게임 포트: 동시에 실행할 게임 서버마다 이 범위 안의 서로 다른 포트를 지정하세요.
MARCHITECT_MINECRAFT_PORT_RANGE=25565-25665

# Linux user and group for your data folders. Check with id -u and id -g.
# Linux 데이터 폴더를 사용할 사용자·그룹입니다. id -u, id -g로 확인하세요.
MARCHITECT_UID=1000
MARCHITECT_GID=1000

# After changing ports or IDs, stop game servers and run the Compose start command again.
# 포트나 ID를 바꾸면 게임 서버를 종료한 뒤 Compose 실행 명령을 다시 실행하세요.
# Manage domains and IP addresses in the web console, not in this file.
# 도메인과 IP 주소는 이 파일 대신 웹 콘솔에서 관리하세요.
