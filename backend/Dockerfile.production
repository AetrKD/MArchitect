FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends gosu \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY docker-entrypoint.sh /usr/local/bin/marchitect-entrypoint
RUN chmod +x /usr/local/bin/marchitect-entrypoint

COPY . ./

ENV PYTHONDONTWRITEBYTECODE=1

# Production deliberately omits --reload so source changes never restart a live server.
ENTRYPOINT ["/usr/local/bin/marchitect-entrypoint"]
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
